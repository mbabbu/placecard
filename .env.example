# Copy to .env for local use (never commit .env). On Render, set these under Environment instead.
# Qloo hackathon key (works only against https://hackathon.api.qloo.com). Empty = SAMPLE data mode.
QLOO_API_KEY=
# auto | mock | gemini | anthropic   (auto: anthropic if its key is set, else gemini, else mock)
LLM_PROVIDER=auto
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Anthropic Console key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Abuse limits for the public demo
# Qloo allows 10,000 requests a month; a cold 40-guest run costs about 145 (cached favourites are free)
RUNS_PER_IP_PER_HOUR=8
RUNS_PER_DAY=120
MAX_AGENT_TURNS=16
MAX_QLOO_CALLS=600
# Requests per second sent to Qloo (the key allows 5); stop spending when this many monthly requests remain
QLOO_RPS=4
QLOO_MONTH_RESERVE=100
# Weight of the favourites' own Qloo tags next to the taste-analysis tags (0 = taste analysis only)
OWN_TAG_WEIGHT=2.0
# Optional: keep Qloo results across restarts (a local file; Render's free disk is ephemeral)
# QLOO_CACHE_FILE=.cache/qloo.json
# Most guests one run may seat
MAX_GUESTS=120
